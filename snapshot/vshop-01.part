S_OaSNuSi_1QTtESGg.jpeg&quot;,&quot;variations&quot;:{&quot;large&quot;:&quot;//thumbs.vivino.com/region_backgrounds/LUg7S_OaSNuSi_1QTtESGg_1280x760.jpeg&quot;,&quot;medium&quot;:&quot;//thumbs.vivino.com/region_backgrounds/LUg7S_OaSNuSi_1QTtESGg_600x356.jpeg&quot;}}},&quot;winery&quot;:{&quot;id&quot;:181740,&quot;name&quot;:&quot;Marqués del Lagar&quot;,&quot;seo_name&quot;:&quot;marques-del-lagar&quot;,&quot;status&quot;:0,&quot;background_image&quot;:null},&quot;taste&quot;:{&quot;structure&quot;:{&quot;acidity&quot;:3.06,&quot;fizziness&quot;:null,&quot;intensity&quot;:3.51,&quot;sweetness&quot;:2.3,&quot;tannin&quot;:3.3,&quot;user_structure_count&quot;:25,&quot;calculated_structure_count&quot;:0},&quot;flavor&quot;:[]},&quot;statistics&quot;:null,&quot;style&quot;:{&quot;id&quot;:190,&quot;seo_name&quot;:&quot;spanish-rioja-red&quot;,&quot;regional_name&quot;:&quot;Espanhol&quot;,&quot;varietal_name&quot;:&quot;Rioja tinto&quot;,&quot;name&quot;:&quot;Rioja espanhol tinto&quot;,&quot;background_image&quot;:null,&quot;image&quot;:null,&quot;description&quot;:&quot;Rioja is one Spain's most famous wine regions and is one of only two regions classified under the Denominación de Origen Calificada (DOCa) system. Its two most important red grapes are Tempranillo and Garnacha.&nbsp;\n\nWhen it comes to Rioja reds, there are 4 categories of ageing to keep in mind:\n\nJoven - There are no specific requirements here, but these wines tend to be 1-2 years old.&nbsp;\n\nCrianza - These wines are in their 3rd year, with at least 12 months spent in oak barrels.\n\nReserva - When excellent vintages are selected to become Reserva wines, they spend 3 years aging, 12 months minimum of which is in oak, followed by 6 months in the bottle.&nbsp;\n\nGran Reserva - The wines carefully selected for this process must undergo a minimum of 60 months aging,&nbsp; of which 2 years must be in oak barrels, with another 2 years spent in the bottle.&nbsp;\n\nTypically younger wines will be lighter in body style, exhibit more fresh fruit characteristics and are suitable to drink while young. Older wines have more developed flavor profiles and earthy characteristics.&quot;,&quot;blurb&quot;:null,&quot;interesting_facts&quot;:[&quot;Archaeologists believe that wine has been cultivated and consumed in the region since between 3000 and 4000 BC.&quot;,&quot;In Spain, wineries are most commonly known as 'bodegas'. &quot;,&quot;The medium body and high acidity in Rioja Reds make them excellent for pairing with a variety of foods.&quot;],&quot;body&quot;:4,&quot;body_description&quot;:&quot;Encorpado&quot;,&quot;acidity&quot;:3,&quot;acidity_description&quot;:&quot;Alto&quot;,&quot;country&quot;:{&quot;code&quot;:&quot;es&quot;,&quot;name&quot;:&quot;Espanha&quot;,&quot;native_name&quot;:&quot;España&quot;,&quot;seo_name&quot;:&quot;spain&quot;,&quot;currency&quot;:{&quot;code&quot;:&quot;EUR&quot;,&quot;name&quot;:&quot;Euros&quot;,&quot;prefix&quot;:&quot;€&quot;,&quot;suffix&quot;:null},&quot;regions_count&quot;:152,&quot;users_count&quot;:2652172,&quot;wines_count&quot;:115025,&quot;wineries_count&quot;:18734,&quot;most_used_grapes&quot;:[{&quot;id&quot;:19,&quot;name&quot;:&quot;Tempranillo&quot;,&quot;seo_name&quot;:&quot;tempranillo&quot;,&quot;has_detailed_info&quot;:true,&quot;wines_count&quot;:172842,&quot;parent_grape_id&quot;:null,&quot;color&quot;:5},{&quot;id&quot;:142,&quot;name&quot;:&quot;Garnacha&quot;,&quot;seo_name&quot;:&quot;garnacha&quot;,&quot;has_detailed_info&quot;:true,&quot;wines_count&quot;:58111,&quot;parent_grape_id&quot;:8,&quot;color&quot;:5},{&quot;id&quot;:2,&quot;name&quot;:&quot;Cabernet Sauvignon&quot;,&quot;seo_name&quot;:&quot;cabernet-sauvignon&quot;,&quot;has_detailed_info&quot;:true,&quot;wines_count&quot;:801751,&quot;parent_grape_id&quot;:null,&quot;color&quot;:5}]},&quot;wine_type_id&quot;:1,&quot;food&quot;:[{&quot;id&quot;:4,&quot;name&quot;:&quot;Carne de vaca&quot;,&quot;weight&quot;:0.5,&quot;background_image&qu